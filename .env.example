# DAYLOOP — Supabase / Cloud機能の環境変数テンプレート。
# 値は空のままコミットする。実際の値は各環境（ローカル / Cloudflare Pages）で設定する。
# 詳細は docs/SUPABASE_SETUP.md を参照。

# --- Frontend（Vite。VITE_ 接頭辞のみがブラウザへ公開される） ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# legacy anon keyのプロジェクトを使っている場合のfallback（無ければ空のままでよい）
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Server専用（Cloudflare Pages Functions の環境変数/Secretとして設定する。
#     VITE_ 接頭辞を付けない = ブラウザへは絶対に公開されない） ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
